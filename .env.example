# ==============================================================================
# SPEAK-UP ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
API_PORT=3000

# ------------------------------------------------------------------------------
# 1. PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=speakup_db
POSTGRES_PORT=5432
# Kết nối từ máy host (khi chạy NestJS ở máy host)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/speakup_db?schema=public

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=speakup_redis_secret

# ------------------------------------------------------------------------------
# 3. RabbitMQ Configuration
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Kết nối AMQP từ máy host
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
